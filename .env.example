# Orbital Radio backend configuration
#
# Copy this file to .env for local use. On Railway, configure the same
# variables in the backend service's Variables tab. Radio Browser does not
# require an API key, and the browser receives station audio directly from the
# broadcaster rather than through FastAPI.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO

# Browser access (comma-separated explicit origins; no credentials/cookies)
CORS_ORIGINS=http://localhost:4174,http://127.0.0.1:4174

# Database and offline geographic data
DATABASE_PATH=./orbital_radio.db
COUNTRY_BOUNDARIES_FILE=./data/country_boundaries.geojson

# Satellite data
TLE_REFRESH_HOURS=12
TLE_STALE_HOURS=12

# Radio Browser metadata requests
RADIO_BROWSER_USER_AGENT=OrbitalRadio/0.1
RADIO_REQUEST_TIMEOUT_SECONDS=5
RADIO_RESULT_LIMIT=50
RADIO_CACHE_TTL_MINUTES=30
RADIO_FAILURE_CACHE_MINUTES=10
