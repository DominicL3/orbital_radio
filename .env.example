# Orbital Radio backend configuration
#
# Copy this file to .env for local use and replace only the placeholder values.
# Never commit .env or place real values in this file. On Railway, add the same
# variables in the backend service's Variables tab instead.

# Application
ENVIRONMENT=development
LOG_LEVEL=INFO
# Generate a unique 32+ character random value for production.
SECRET_KEY=replace-with-a-unique-random-secret-at-least-32-characters-long

# Spotify OAuth
# Create these in the Spotify Developer Dashboard. The client secret must stay
# on the backend and must never be exposed as a VITE_* frontend variable.
SPOTIFY_CLIENT_ID=replace-with-your-spotify-client-id
SPOTIFY_CLIENT_SECRET=replace-with-your-spotify-client-secret
# Must exactly match an allowlisted Spotify Redirect URI. Use your Railway API
# domain in production, for example https://api.example.com/auth/spotify/callback.
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/auth/spotify/callback

# Browser access
# Comma-separated origins that may make credentialed requests to the API.
# Set this to your public frontend URL in production.
CORS_ORIGINS=http://localhost:3000,http://localhost:8000

# Data and session behavior
DATABASE_PATH=./orbital_radio.db
SESSION_EXPIRE_HOURS=3
OAUTH_STATE_MINUTES=10
MAX_PLAYED_TRACKS_PER_SESSION=500

# Satellite data
TLE_REFRESH_HOURS=12
TLE_STALE_HOURS=12
COUNTRY_BOUNDARIES_FILE=./data/country_boundaries.geojson

# Playlist behavior
COUNTRY_COOLDOWN_SONGS=5
PLAYLIST_CACHE_MAX_AGE_HOURS=24
PREFETCH_PLAYLISTS_ON_STARTUP=true
